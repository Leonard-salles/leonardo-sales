rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /testimonials/{testimonialId} {
      allow read: if resource.data.approved == true;

      allow create: if
        !exists(/databases/$(database)/documents/testimonials/$(testimonialId)) &&
        request.resource.data.approved == false &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 1000 &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /testimonialContacts/{testimonialId} {
      // Never readable by any client — only the Firebase Console / Admin SDK bypasses rules.
      allow read: if false;

      allow create: if
        !exists(/databases/$(database)/documents/testimonialContacts/$(testimonialId)) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0;

      allow update, delete: if false;
    }
  }
}
